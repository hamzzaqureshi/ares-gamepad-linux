# ==============================================================================
# Udev Rules for Cosmic Byte Ares Pro & GameSir Cyclone Controllers
# Grants desktop user (uaccess) read/write permissions to input & hidraw nodes.
# ==============================================================================

# Genuine XInput Mode (045e:02fd wired / 045e:028e)
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02fd", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02fd", TAG+="uaccess", MODE="0666"

# 2.4GHz Wireless Dongle (3537:0575 idle / 3537:100b connected)
SUBSYSTEM=="input", ATTRS{idVendor}=="3537", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3537", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3537", TAG+="uaccess", MODE="0666"

# ShanWan / Nubia / Surge Identifiers (20bc:* / 2563:* / 2c16:*)
SUBSYSTEM=="input", ATTRS{idVendor}=="20bc", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="20bc", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="20bc", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="input", ATTRS{idVendor}=="2563", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2563", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2563", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="input", ATTRS{idVendor}=="2c16", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2c16", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2c16", TAG+="uaccess", MODE="0666"

# Virtual Controller node (uinput)
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", MODE="0666"
