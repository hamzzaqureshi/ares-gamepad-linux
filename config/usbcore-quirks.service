[Unit]
Description=Apply usbcore descriptor quirks for Cosmic Byte Ares Pro & GameSir controllers
DefaultDependencies=no
Before=systemd-udevd.service udev.service
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo -n "045e:02fd:r,3537:0575:r,3537:100b:r,3537:1052:r,3537:1053:r,20bc:5001:r,2563:0575:r,2563:028e:r" > /sys/module/usbcore/parameters/quirks'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
